</div>


@section Styles{
    <style>
    .upload-container {
    width: 100%;
    box-sizing: border-box;
    padding: 50px 20px;
    border: 2px dashed #aaa;
    border-radius: 12px;
    text-align: center;
    background: #f8f9fa;
    }

    .upload-icon {
    font-size: 55px;
    color: #007bff;
    margin-bottom: 15px;
    }

    .file-input {
    width: 100%;
    max-width: 600px;
    margin: 20px auto;
    }

    .btn-upload {
    background: #007bff;
    color: white;
    border: none;
    padding: 12px 35px;
    border-radius: 6px;
    cursor: pointer;
    }
        </style>
    }

    @section scripts{
        <script>
            $(document).ready(function () {

            });


            function ValidatingFileUpload(controlId) {

                var _control = $('#' + controlId);
                const maxSize = 15 * 1024 * 1024; // 15 MB

                for (let i = 0; i < _control[0].files.length; i++) {
                    if (_control[0].files[i].size > maxSize) {
                        alert("You are trying to upload a file which is more than 15 MB. Please try to compress/optimise it and then upload again");
                        // Clear all selected files
                        $(_control).val("");

                        return false;
                    }
                }
            };


            function CheckValueAndMakeFieldMandatory(value, feildtoCheck, feildToControl, showhideTr = false, doNotAddRequiredAttribute = false) {
                if ($("#" + feildtoCheck).val() == value) {
                    if (doNotAddRequiredAttribute == false) {
                        $("#" + feildToControl).attr('required', 'required');
                    }
                    else {
                        $("#" + feildToControl).removeAttr('required');
                    }
                    if (showhideTr == true) {
                        $("#tr" + feildToControl).show();
                    }
                }
                else {
                    $("#" + feildToControl).removeAttr('required');
                    if (doNotAddRequiredAttribute == false) {
                        $("#" + feildToControl).removeAttr('required');
                    }
                    if (showhideTr == true) {
                        $("#tr" + feildToControl).hide();
                    }
                }
            };



            const dropArea1 = document.getElementById("dropArea1");
            const fileInput1 = document.getElementById("Answer1Filename");

            dropArea1.addEventListener("click", function () {
                fileInput1.click();
            });

 

            dropArea1.addEventListener("dragover", function (e) {
                e.preventDefault();
                dropArea1.classList.add("dragover");
            });

            dropArea1.addEventListener("dragleave", function () {
                dropArea1.classList.remove("dragover");
            });

            dropArea1.addEventListener("drop", function (e) {
                e.preventDefault();
                dropArea1.classList.remove("dragover");

                if (e.dataTransfer.files.length > 0) {
                    fileInput1.files = e.dataTransfer.files;
                }
            });



            const dropArea3 = document.getElementById("dropArea3");
            const fileInput3 = document.getElementById("Answer3Filename");

            dropArea3.addEventListener("click", function () {
                fileInput3.click();
            });



            dropArea3.addEventListener("dragover", function (e) {
                e.preventDefault();
                dropArea3.classList.add("dragover");
            });

            dropArea3.addEventListener("dragleave", function () {
                dropArea3.classList.remove("dragover");
            });

            dropArea3.addEventListener("drop", function (e) {
                e.preventDefault();
                dropArea3.classList.remove("dragover");

                if (e.dataTransfer.files.length > 0) {
                    fileInput3.files = e.dataTransfer.files;
                }
            });


            const dropArea4 = document.getElementById("dropArea4");
            const fileInput4 = document.getElementById("Answer4Filename");

            dropArea4.addEventListener("click", function () {
                fileInput4.click();
            });



            dropArea4.addEventListener("dragover", function (e) {
                e.preventDefault();
                dropArea4.classList.add("dragover");
            });

            dropArea4.addEventListener("dragleave", function () {
                dropArea4.classList.remove("dragover");
            });

            dropArea4.addEventListener("drop", function (e) {
                e.preventDefault();
                dropArea4.classList.remove("dragover");

                if (e.dataTransfer.files.length > 0) {
                    fileInput4.files = e.dataTransfer.files;
                }
            });




            const dropArea10 = document.getElementById("dropArea10");
            const fileInput10 = document.getElementById("Answer10Filename");

            dropArea10.addEventListener("click", function () {
                fileInput10.click();
            });



            dropArea10.addEventListener("dragover", function (e) {
                e.preventDefault();
                dropArea10.classList.add("dragover");
            });

            dropArea10.addEventListener("dragleave", function () {
                dropArea10.classList.remove("dragover");
            });

            dropArea10.addEventListener("drop", function (e) {
                e.preventDefault();
                dropArea10.classList.remove("dragover");

                if (e.dataTransfer.files.length > 0) {
                    fileInput10.files = e.dataTransfer.files;
                }
            });



            let isSubmitting = false;

            document.getElementById("SubmitFormDataBreach")
                .addEventListener("submit", function (e) {

                    if (isSubmitting) {
                        e.preventDefault();
                        return false;
                    }

                    isSubmitting = true;

                    // Disable submit button
                    document.getElementById("SubmitButton").disabled = true;

                });

        </script>

    }