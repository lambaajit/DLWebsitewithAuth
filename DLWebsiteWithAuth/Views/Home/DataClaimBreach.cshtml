                        Upload Evidence<font class="required1">*</font>
                        <br />
                        <div class="upload-container" id="dropArea3">

                            <i class="fa fa-cloud-upload upload-icon"></i>

                            <h3>Drag & Drop Files Here</h3>
                            <p>or click below to browse files</p>

                            <input type="file"
                                   name="Answer3Filename"
                                   id="Answer3Filename"
                                   onchange="ValidatingFileUpload('Answer3Filename')"
                                   class="form-control file-input" />


                        </div>

                        @Html.ValidationMessageFor(x => x.Answer3Filename, null, new { @class = "validation-error" })
                    </td>


                </tr>







                <tr>
                    <td>
