                        @Html.TextAreaFor(x => x.Answer7, new { @class = "form-control", autocomplete = "off", rows = "5", required = "required" })
                        @Html.ValidationMessageFor(x => x.Answer7, null, new { @class = "validation-error" })

                    </td>
                </tr>


                <tr>
