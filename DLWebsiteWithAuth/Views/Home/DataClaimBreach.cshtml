                        you became aware of the LAA data breach? For
                        example,text/WhatsApp/iMessage messages to friends or family,
                        journal entries, notes from therapy or counselling sessions. If yes,
                        please confirm what.<font class="required1">*</font>
                    </td>
                    <td>
                        @Html.TextAreaFor(x => x.Answer10, new { @class = "form-control", autocomplete = "off", rows = "5", required = "required" })
                        @Html.ValidationMessageFor(x => x.Answer10, null, new { @class = "validation-error" })
                    </td>
                </tr>
                <tr>
                    <td>
                        Evidence<font class="required1">*</font>
                    </td>
                    <td>
                        @Html.DropDownListFor(x => x.Answer10Evidence, new List<SelectListItem>() { new SelectListItem() { Text = "Yes", Value = "Yes" }, new SelectListItem() { Text = "No", Value = "No" } }, "Please Select", new { id = "Answer10Evidence", @class = "form-control", required = "required", onchange = "CheckValueAndMakeFieldMandatory('Yes', 'Answer10Evidence', 'Answer10Filename', true)" })
                        @Html.ValidationMessageFor(x => x.Answer10Evidence, null, new { @class = "validation-error" })
                    </td>
                </tr>
                <tr id="trAnswer10Filename" style="display:none">

                    <td colspan="2">
                        Upload Evidence<font class="required1">*</font>
                        <br />
                        <div class="upload-container" id="dropArea10">

                            <i class="fa fa-cloud-upload upload-icon"></i>

                            <h3>Drag & Drop Files Here</h3>
                            <p>or click below to browse files</p>

                            <input type="file"
                                   name="Answer10Filename"
                                   onchange="ValidatingFileUpload('Answer10Filename')"
                                   id="Answer10Filename"
                                   class="form-control file-input" />


                        </div>

                        @Html.ValidationMessageFor(x => x.Answer10Filename, null, new { @class = "validation-error" })
                    </td>


                </tr>



                <tr>
                    <td>
                        11. Is there anyone who has witnessed the impact of the LAA data
                        breach on you and who could provide a statement in support? If yes,
                        please confirm who they are, their relationship to you and their contact
                        details.<font class="required1">*</font>
                    </td>
                    <td>
                    </td>
                </tr>
                <tr>
                    <td>
                        Witness 1 willing to give a witness statement?: *
                        <font class="required1">*</font>
                    </td>
                    <td>
                        @Html.DropDownListFor(x => x.Answer11EvidenceWitness1, new List<SelectListItem>() { new SelectListItem() { Text = "Yes", Value = "Yes" }, new SelectListItem() { Text = "No", Value = "No" } }, "Please Select", new { id = "Answer11EvidenceWitness1", @class = "form-control", required = "required", onchange = "CheckValueAndMakeFieldMandatory('Yes', 'Answer11EvidenceWitness1', 'Answer11Witness1Name', true); CheckValueAndMakeFieldMandatory('Yes', 'Answer11EvidenceWitness1', 'Answer11Witness1Relationship', true); CheckValueAndMakeFieldMandatory('Yes', 'Answer11EvidenceWitness1', 'Answer11Witness1ContactNo', true); CheckValueAndMakeFieldMandatory('Yes', 'Answer11EvidenceWitness1', 'Answer11EvidenceWitness2', true)" })
                        @Html.ValidationMessageFor(x => x.Answer11EvidenceWitness1, null, new { @class = "validation-error" })
                    </td>
                </tr>

                <tr id="trAnswer11Witness1Name" style="display:none">
                    <td style="width:60%;">Witness 1 - Name<font class="required1">*</font></td>
                    <td>
                        @Html.TextBoxFor(x => x.Answer11Witness1Name, new { @class = "form-control", autocomplete = "off" })
                        @Html.ValidationMessageFor(x => x.Answer11Witness1Name, null, new { @class = "validation-error" })
                    </td>
