                    </td>
                    <td>
                        @Html.TextAreaFor(x => x.Answer9, new { @class = "form-control", autocomplete = "off", rows = "5", required = "required" })
                        @Html.ValidationMessageFor(x => x.Answer9, null, new { @class = "validation-error" })

                    </td>
                </tr>






                <tr>
                    <td>
